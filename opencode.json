{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "PROPAGATION_RULES.md"],
  "permission": {
    "edit": {
      ".opencode/commands/documentos-proyectos.md": "ask",
      "Manual_OpenCode_Codanor.html": "ask",
      "AGENTS.md": "ask",
      "PROPAGATION_RULES.md": "ask",
      "*": "allow"
    }
  },
  "mcp": {
    "sonarqube": {
      "type": "local",
      "command": ["npx", "-y", "sonarqube-mcp-server@latest"],
      "enabled": true,
      "environment": {
        "SONARQUBE_URL": "https://sonarcloud.io",
        "SONARQUBE_TOKEN": "{env:SONAR_TOKEN}",
        "SONARQUBE_ORGANIZATION": "Jfajeda"
      }
    }
  }
}

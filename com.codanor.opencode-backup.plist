<?xml version="1.0" encoding="UTF-8"?>
<!--
  com.codanor.opencode-backup.plist
  Agente launchd para backup automatico de OpenCode.
  CODANOR - Jafa, S.L. | Barcelona, Catalunya

  TAREA: Backup completo diario a las 09:00
  (La prueba de restauracion --test-restore esta en com.codanor.opencode-testrestore.plist)

  LOG (local, siempre accesible independiente del NAS):
    ~/Library/Logs/com.codanor.opencode-backup.log
    Consultar: tail -f ~/Library/Logs/com.codanor.opencode-backup.log

  INSTALACION:
    cp com.codanor.opencode-backup.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.codanor.opencode-backup.plist

  EJECUTAR MANUALMENTE:
    launchctl start com.codanor.opencode-backup

  DESINSTALAR:
    launchctl unload ~/Library/LaunchAgents/com.codanor.opencode-backup.plist

  NOTA NAS: el share CODANOR requiere TCC "Acceso total al disco" para launchd.
    Alternativa sin TCC: anadirlo como Login Item (Ajustes > General > Elementos
    de inicio de sesion) para que se monte antes de las 09:00.
    Una vez resuelto, intercambiar OPENCODE_BACKUP_DIR y OPENCODE_BACKUP_DIR_REDUNDANT.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.codanor.opencode-backup</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/jaimefajeda/Proyectos/PLATAFORMA_OpenCode-NEW/backup-opencode.sh</string>
  </array>

  <!-- Backup completo diario a las 09:00 -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <!-- Variables de entorno -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>/Users/jaimefajeda</string>
    <!-- Destino principal: Transcend (escritura confirmada) -->
    <key>OPENCODE_BACKUP_DIR</key>
    <string>/Volumes/Transcend/opencode-backups</string>
    <!-- Redundancia: NAS CODANOR (falla silenciosamente si no tiene TCC) -->
    <key>OPENCODE_BACKUP_DIR_REDUNDANT</key>
    <string>/Volumes/CODANOR/opencode-backups</string>
    <!-- iCloud Drive: externalizado a internet (automatico via iCloud) -->
    <key>OPENCODE_ICLOUD_DIR</key>
    <string>/Users/jaimefajeda/Library/Mobile Documents/com~apple~CloudDocs/CODANOR-Backups</string>
  </dict>

  <!-- Log LOCAL: independiente del NAS, siempre accesible -->
  <key>StandardOutPath</key>
  <string>/Users/jaimefajeda/Library/Logs/com.codanor.opencode-backup.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/jaimefajeda/Library/Logs/com.codanor.opencode-backup.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
